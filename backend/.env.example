# ─────────────────────────────────────────────────────────────────────────────
# AgentCart Environment Variables Example
# ─────────────────────────────────────────────────────────────────────────────

PROJECT_NAME="AgentCart — Safe Agentic Commerce Platform"
SECRET_KEY=your_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here
DEBUG=true
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/agentcart?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/agentcart?retryWrites=true&w=majority
MONGODB_DATABASE=agentcart

# LLM Providers
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=your_groq_api_key_here
DEFAULT_LLM_PROVIDER=gemini

# Razorpay Test Mode
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Guardrails & Policy
DEFAULT_MAX_BUDGET=50000
MAX_QUANTITY_PER_ORDER=5
ALLOWED_CURRENCY=INR
REQUIRE_APPROVAL_FOR_ALL_PURCHASES=true
ENABLE_SAFETY_GUARDRAILS=true
